# =============================================================================
# LinkFlow — Backend Environment Variables
# Copy this file to .env and fill in all required values before running.
# Variables marked [REQUIRED] have no default and will cause startup failure
# if omitted. Variables marked [OPTIONAL] have safe defaults for development.
# =============================================================================

# ==========================
# Server [OPTIONAL]
# ==========================
# The port the Spring Boot server listens on.
# Many cloud platforms (Render, Railway, Heroku) inject PORT automatically.
PORT=8080

# ==========================
# MySQL Connection [REQUIRED]
# ==========================
DB_URL=jdbc:mysql://localhost:3306/urlshortenerdb
DB_USERNAME=replace-with-your-database-username
DB_PASSWORD=replace-with-your-database-password

# ==========================
# JWT [REQUIRED]
# ==========================
# Must be a Base64-encoded HMAC-SHA secret of at least 256 bits (32 bytes).
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-secure-base64-encoded-secret
# Token lifetime in milliseconds. Default: 172800000 (48 hours).
JWT_EXPIRATION_MS=172800000

# ==========================
# CORS [REQUIRED in production]
# ==========================
# Comma-separated list of allowed frontend origins.
# Example (production): CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
# Example (local dev):  CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==========================
# JPA / Hibernate [OPTIONAL]
# ==========================
# Never set to 'update' or 'create' in production.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# ==========================
# HikariCP Connection Pool [OPTIONAL]
# ==========================
# Tune these based on your database plan's max connection limit.
HIKARI_MIN_IDLE=5
HIKARI_MAX_POOL_SIZE=20
HIKARI_CONNECTION_TIMEOUT_MS=30000
HIKARI_IDLE_TIMEOUT_MS=600000
HIKARI_MAX_LIFETIME_MS=1800000
HIKARI_KEEPALIVE_MS=60000

# ==========================
# Logging [OPTIONAL]
# ==========================
# Recommended production values: ROOT_LOG_LEVEL=WARN, APP_LOG_LEVEL=INFO
ROOT_LOG_LEVEL=INFO
SPRING_SECURITY_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# ==========================
# Spring Profile [REQUIRED in production]
# ==========================
# Activates application-prod.properties which tightens log levels,
# locks DDL to validate, and restricts Actuator exposure.
# SPRING_PROFILES_ACTIVE=prod
