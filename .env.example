# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/urlshortenerdb
DB_USERNAME=root
DB_PASSWORD=replace-with-your-database-password

# Base64-encoded JWT signing secret
JWT_SECRET=replace-with-a-secure-base64-encoded-secret
JWT_EXPIRATION_MS=172800000

# Application configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
SPRING_SECURITY_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
